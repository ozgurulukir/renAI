# =============================================================================
# renAI Configuration File
# =============================================================================
# Copy this file to your config directory and fill in your values
#
# Location:
#   Windows: %APPDATA%\renAI\renAI\.env
#   Linux:   ~/.config/renAI/.env
#   Mac:     ~/Library/Application Support/renAI/.env
#
# Or set values directly in shell:
#   export RENAI_PROVIDER=openai
# =============================================================================

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================

# LLM Provider (deepinfra, openrouter, openai, custom)
RENAI_PROVIDER=deepinfra

# Default model (leave empty to use provider default)
# RENAI_MODEL=

# Number of concurrent workers (1-32, recommended: 4-8)
RENAI_WORKERS=4

# Max characters to send to LLM (100-100000, recommended: 10000)
RENAI_TEXT_LENGTH=10000

# PDF text extractor (pymupdf, pdfplumber, pypdf, pypdfium2)
RENAI_EXTRACTOR=pymupdf

# Show warnings before processing (true/false)
RENAI_SHOW_WARNINGS=true

# Process subdirectories recursively (true/false)
RENAI_RECURSIVE=true

# Strategy when text extraction fails (none, ocr, vision, move)
RENAI_FALLBACK_MODE=none

# Move files that fail all attempts to Scan_Failures folder (true/false)
RENAI_MOVE_SCAN_FAILURES=false

# Rename image files using vision model (true/false)
RENAI_RENAME_IMAGES=false

# Add EXIF date to image filenames (true/false)
RENAI_EXIF=false

# =============================================================================
# API KEYS
# =============================================================================

# DeepInfra API Key
# Get yours at: https://deepinfra.com/dashboard/api-keys
# DEEPINFRA_API_KEY=

# OpenRouter API Key
# Get yours at: https://openrouter.ai/settings
# OPENROUTER_API_KEY=

# OpenAI API Key
# Get yours at: https://platform.openai.com/api-keys
# OPENAI_API_KEY=

# =============================================================================
# CUSTOM PROVIDER (Local Inference)
# =============================================================================

# Custom API Base URL (Ollama, LM Studio, etc.)
CUSTOM_API_BASE_URL=http://localhost:8000/v1

# Custom API Key (usually not required for local)
CUSTOM_API_KEY=not-required

# Custom Model Name
CUSTOM_MODEL=llama3

# =============================================================================
# OCR SETTINGS (Optional)
# =============================================================================

# Tesseract path (if not in PATH)
# Windows: TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe
# Linux:   TESSERACT_PATH=/usr/bin/tesseract
# Mac:     TESSERACT_PATH=/usr/local/bin/tesseract

# Enable high-quality OCR with enhancements (true/false)
RENAI_OCR_ENHANCED=false

# Use mutool for high-quality conversion (true/false)
RENAI_USE_MUTOOL=false

# Save OCR debug images (true/false)
RENAI_DEBUG_OCR=false

# Skip OCR for files needing fallback (true/false)
RENAI_SKIP_NEEDS_OCR=false

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================

# Debug mode (true/false)
# RENAI_DEBUG=false

# Log level (DEBUG, INFO, WARNING, ERROR)
# RENAI_LOG_LEVEL=INFO

# =============================================================================

# =============================================================================
# PROVIDER-SPECIFIC MODELS (Cache-aware)
# =============================================================================
# OpenAI:     gpt-4o, gpt-4o-mini
# DeepInfra:  meta-llama/Llama-3.2-90B-Vision-Instruct, Qwen/Qwen2.5-72B-Instruct
# OpenRouter: google/gemini-2.0-flash-exp:free, openai/gpt-4o

RENAI_MODEL=gpt-4o
DEEPINFRA_MODEL=meta-llama/Llama-3.2-90B-Vision-Instruct
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free
OPENAI_MODEL=gpt-4o

# Path to mutool executable (if not in PATH)
RENAI_MUTOOL_PATH=mutool
